{
  "name": "biblionx-translator-api",
  "description": "Biblionx translation service API (Spanish text to Dominican Sign Language, LSRD)",
  "version": "2.4.0",
  "private": true,
  "contributors": [
    "Biblionx Team"
  ],
  "scripts": {
    "build": "babel src --out-dir dist --copy-files --include-dotfiles",
    "dev": "npm run build && DEBUG=biblionx-translator-*:* NODE_ENV=dev node dist/index.js",
    "start": "DEBUG=biblionx-translator-api:info NODE_ENV=production node dist/index.js",
    "prepare": "node .husky/install.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "amqplib": "^2.2.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "http-errors": "^2.0.1",
    "ioredis": "^5.11.1",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
