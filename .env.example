# Biblionx Translator API Configuration

# HTTP Server Configuration
BIBLIONX_PORT=3000
PORT=3000
BIBLIONX_LOGGER_FORMAT=dev
LOGGER_FORMAT=dev

# Database Configuration (MongoDB)
BIBLIONX_DB_HOST=mongo
DB_HOST=mongo
BIBLIONX_DB_PORT=27017
DB_PORT=27017
BIBLIONX_DB_NAME=biblionx-db
DB_NAME=biblionx-db

# Cache Configuration (Redis)
BIBLIONX_CACHE_HOST=redis
CACHE_HOST=redis
BIBLIONX_CACHE_PORT=6379
CACHE_PORT=6379
BIBLIONX_CACHE_NAME=biblionx-cache
CACHE_NAME=biblionx-cache
CACHE_SIZE=104857600
CACHE_EXP=604800

# Message Broker Configuration (RabbitMQ)
BIBLIONX_AMQP_PROTOCOL=amqp
AMQP_PROTOCOL=amqp
BIBLIONX_AMQP_HOST=rabbitmq
AMQP_HOST=rabbitmq
BIBLIONX_AMQP_PORT=5672
AMQP_PORT=5672
BIBLIONX_AMQP_USER=guest
AMQP_USER=guest
BIBLIONX_AMQP_PASS=guest
AMQP_PASS=guest
BIBLIONX_TRANSLATOR_QUEUE=translate.to_text
TRANSLATOR_QUEUE=translate.to_text
BIBLIONX_VIDEOMAKER_QUEUE=translate.to_video
VIDEOMAKER_QUEUE=translate.to_video
BIBLIONX_API_CONSUMER_QUEUE=amq.rabbitmq.reply-to
API_CONSUMER_QUEUE=amq.rabbitmq.reply-to
